# =============================================================================
# Network Binding (127.0.0.1 restricts exposure to localhost by default)
# =============================================================================
BIND_HOST=127.0.0.1

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=piciz_admin
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=n8n_db
RPA_DB_NAME=gestion_usuarios
RPA_DB_HOST=postgres
RPA_DB_PORT=5432

# =============================================================================
# n8n Workflow Engine Configuration
# =============================================================================
GENERIC_TIMEZONE=America/Bogota
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# =============================================================================
# ngrok Tunnel (Optional - enabled only with `--profile tunnel`)
# =============================================================================
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
NGROK_DOMAIN=your-domain.ngrok-free.dev

# =============================================================================
# RPA API Security & Runtime Configuration
# =============================================================================
# Set a strong random token to protect RPA endpoints via the X-API-Key header.
# Leave empty ONLY for isolated local testing.
API_KEY=replace_with_strong_api_key
LOG_LEVEL=INFO
RPA_TIMEOUT_SECONDS=120

# =============================================================================
# PICIZ Web Portal Configuration & RPA Behavior
# =============================================================================
PICIZ_URL=https://picizweb31.grupozfb.com/picizweb/#/home
PICIZ_ZONA_FRANCA=Zona Franca Permanente Santander
PICIZ_COMPANY=CAMPUSLANDS S.A.S. BIC
PICIZ_USER=replace_with_piciz_username
PICIZ_PASSWORD=replace_with_piciz_password
PICIZ_PERSONA_VISITA=Campuslands

# Safety switch: when "true", the bot fills the form and takes a verification
# screenshot WITHOUT clicking the final "Guardar" button.
RPA_DRY_RUN=true
RPA_HEADLESS=true
